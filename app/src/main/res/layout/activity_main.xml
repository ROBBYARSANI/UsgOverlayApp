<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    ==================
    Layout sederhana untuk MainActivity:
    - StatusText: menampilkan status terkini alur perizinan / service
    - StartButton: memulai alur perizinan dan deteksi
    - StopButton: menghentikan service deteksi
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1A1A2E">

    <!-- Icon / judul aplikasi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🩻 Deteksi Vena USG"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#E0E0E0"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real-Time Vein Detection with YOLOv8"
        android:textSize="13sp"
        android:textColor="#A0A0A0"
        android:layout_marginBottom="48dp"/>

    <!-- Panel status -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#16213E"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Sistem"
                android:textSize="12sp"
                android:textColor="#7986CB"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Siap dimulai. Tekan START untuk memulai deteksi."
                android:textSize="15sp"
                android:textColor="#E0E0E0"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Tombol Mulai -->
    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="▶  MULAI DETEKSI"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Tombol Berhenti -->
    <Button
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="■  HENTIKAN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#C62828"
        android:textColor="#FFFFFF"
        android:enabled="false"/>

    <!-- Informasi di bawah -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aplikasi akan meminta izin overlay, notifikasi, dan capture layar secara berurutan."
        android:textSize="12sp"
        android:textColor="#606070"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>

