<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay permission: untuk WindowManager TYPE_APPLICATION_OVERLAY -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service: wajib agar service bisa berjalan di foreground -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Foreground service type media projection: wajib di Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- POST_NOTIFICATIONS: wajib di Android 13+ untuk notifikasi foreground service -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UsgAndroidApp">

        <!-- Main Activity: menangani alur perizinan (overlay, notifikasi, screen capture) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VeinDetectionService: Foreground Service dengan tipe mediaProjection.
             foregroundServiceType wajib dideklarasikan untuk Android 14+ agar
             service diizinkan menggunakan MediaProjection API di foreground. -->
        <service
            android:name=".VeinDetectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
